{
  "name": "goha",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/consistency-sweep.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node db/migrate.mts",
    "db:seed-quotes": "node --experimental-strip-types scripts/seed-quotes.mts",
    "db:merge-accounts": "node --experimental-strip-types scripts/merge-accounts.mts",
    "db:diagnose": "node --experimental-strip-types scripts/diagnose.mts",
    "db:backup": "node --experimental-strip-types scripts/backup.mts",
    "db:restore-check": "node --experimental-strip-types scripts/restore-check.mts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:account:create": "node --experimental-strip-types scripts/test-account.mts create",
    "test:account:reset": "node --experimental-strip-types scripts/test-account.mts reset",
    "test:account:destroy": "node --experimental-strip-types scripts/test-account.mts destroy",
    "check:consistency": "node scripts/consistency-sweep.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@xyflow/react": "^12.11.2",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "web-push": "3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
