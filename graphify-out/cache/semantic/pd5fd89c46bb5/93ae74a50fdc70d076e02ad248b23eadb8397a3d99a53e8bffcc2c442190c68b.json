{"nodes": [{"id": "design_stitch_goha_productivity_system_dashboard_task_map_explorer_screen", "label": "Task Map Explorer Screen (Stitch design)", "file_type": "image", "source_file": "design/stitch_goha_productivity_system_dashboard/task_map_explorer/screen.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_goha_productivity_system_dashboard_task_map_explorer_screen_sidebar_nav", "label": "GoHa Global Sidebar Navigation", "file_type": "image", "source_file": "design/stitch_goha_productivity_system_dashboard/task_map_explorer/screen.png", "source_location": "left rail: GoHa / Life Operating System wordmark, Today, Goals, To-dos, Task Map (active), Focus, Habits, Calendar, Brain Dump, Life Areas, Review, Progress, Settings, Quick Action, Help, Logout", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_goha_productivity_system_dashboard_task_map_explorer_screen_active_nav_state", "label": "Active Nav Item Treatment (Task Map selected)", "file_type": "concept", "source_file": "design/stitch_goha_productivity_system_dashboard/task_map_explorer/screen.png", "source_location": "sidebar: 'Task Map' row rendered as a filled sage/green pill while all other rows are plain text on the off-white rail", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_goha_productivity_system_dashboard_task_map_explorer_screen_maps_explorer_panel", "label": "Maps Explorer List Panel", "file_type": "image", "source_file": "design/stitch_goha_productivity_system_dashboard/task_map_explorer/screen.png", "source_location": "second column headed 'MAPS EXPLORER' with a '+' create affordance; entries Dashboard Redesign (selected), Q3 Marketing Launch, Onboarding Flow", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_goha_productivity_system_dashboard_task_map_explorer_screen_three_column_layout", "label": "Three Column Master-Detail-Canvas Layout", "file_type": "rationale", "source_file": "design/stitch_goha_productivity_system_dashboard/task_map_explorer/screen.png", "source_location": "whole screen: fixed app nav rail, narrow map picker column, then a flood-fill canvas", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separating app navigation from map selection from the canvas lets the user switch between several saved maps without losing global orientation, and gives the graph the maximum remaining width because a node graph is the least compressible surface in the product."}, {"id": "design_stitch_goha_productivity_system_dashboard_task_map_explorer_screen_dashboard_redesign_map", "label": "Dashboard Redesign (example task map)", "file_type": "concept", "source_file": "design/stitch_goha_productivity_system_dashboard/task_map_explorer/screen.png", "source_location": "selected explorer entry whose graph is rendered on the canvas", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_goha_productivity_system_dashboard_task_map_explorer_screen_map_canvas", "label": "Graph Canvas with Grid Background", "file_type": "image", "source_file": "design/stitch_goha_productivity_system_dashboard/task_map_explorer/screen.png", "source_location": "right region: pale square grid signalling a pannable, zoomable infinite plane", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_goha_productivity_system_dashboard_task_map_explorer_screen_canvas_toolbar", "label": "Floating Canvas Toolbar", "file_type": "image", "source_file": "design/stitch_goha_productivity_system_dashboard/task_map_explorer/screen.png", "source_location": "pill floating over the canvas top-right: View | Edit, then add-node (square-plus), add-decision (triangle), add-note (note icon), add-progress (trend arrow)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_goha_productivity_system_dashboard_task_map_explorer_screen_view_edit_toggle", "label": "View / Edit Mode Toggle", "file_type": "rationale", "source_file": "design/stitch_goha_productivity_system_dashboard/task_map_explorer/screen.png", "source_location": "left segment of the floating toolbar; 'View' is the active pill (eye icon), 'Edit' is the inactive pencil option", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defaulting to a read-only View mode protects an existing map from accidental drags and stray node creation; authoring tools stay one deliberate click away in Edit mode."}, {"id": "design_stitch_goha_productivity_system_dashboard_task_map_explorer_screen_task_node_card", "label": "Task Node Card (Step 1..Step 5)", "file_type": "image", "source_file": "design/stitch_goha_productivity_system_dashboard/task_map_explorer/screen.png", "source_location": "white rounded cards: step chip, overflow '...' menu, large title, small description (List Sections / Wireframe / Build Layout / Connect Data)", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_goha_productivity_system_dashboard_task_map_explorer_screen_active_node_state", "label": "Active Node State with Inline Progress", "file_type": "concept", "source_file": "design/stitch_goha_productivity_system_dashboard/task_map_explorer/screen.png", "source_location": "'Step 3 - Active / Build Layout' card: dark border ring, play/start glyph replacing the '...' menu, and a partially filled progress bar along the bottom", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One node is visually elevated so the map answers 'what am I doing right now' at a glance, and its play control is the hand-off point into Focus Mode."}, {"id": "design_stitch_goha_productivity_system_dashboard_task_map_explorer_screen_decision_node", "label": "Decision Node (hexagon)", "file_type": "image", "source_file": "design/stitch_goha_productivity_system_dashboard/task_map_explorer/screen.png", "source_location": "amber/tan hexagon reading 'Does it look good?' below the active step", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_goha_productivity_system_dashboard_task_map_explorer_screen_branch_edges", "label": "Labelled Yes / No Branch Edges", "file_type": "concept", "source_file": "design/stitch_goha_productivity_system_dashboard/task_map_explorer/screen.png", "source_location": "solid grey arrows chain Step 1 to Step 2 to Step 3 to the hexagon; a solid dark 'Yes' arrow goes right to Step 5, a dashed red 'No' arrow loops back up into Build Layout", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Colour and dash pattern encode edge semantics: forward progress is solid and neutral, the rework loop is dashed and red so a cycle in the plan reads as a cycle rather than as clutter."}, {"id": "design_stitch_goha_productivity_system_dashboard_task_map_explorer_screen_sticky_note", "label": "Pinned Sticky Note Annotation", "file_type": "image", "source_file": "design/stitch_goha_productivity_system_dashboard/task_map_explorer/screen.png", "source_location": "lavender slightly rotated note with a pin glyph: '\"Keep the sidebar fluid on mobile.\" - Client'", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_goha_productivity_system_dashboard_task_map_explorer_screen_focus_mode_entry", "label": "Focus Mode Entry Point from Task Map", "file_type": "concept", "source_file": "design/stitch_goha_productivity_system_dashboard/task_map_explorer/screen.png", "source_location": "header right: outlined 'Focus Mode' button beside the filled 'Add T...' (Add Task) button", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_sti