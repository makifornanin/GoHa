# GoHa environment template. Copy to `.env.local` and fill in real values there.
# This file lists variable NAMES ONLY. Never put real secrets in it.
# `.env.local` is gitignored; this template is the only tracked env file.
#
# How these files are read (audit R-19). Next.js loads them at runtime; the CLI
# tools (db:migrate, db:generate, db:backup, db:diagnose) share ONE reader,
# `scripts/lib/env.mts`, which follows the same precedence:
#
#   1. the real process environment (CI, a shell prefix) always wins
#   2. .env.local
#   3. .env.$NODE_ENV
#   4. .env
#
# `scripts/lib/require-test-db.mts` deliberately keeps its own reader: it is the
# guard between a destructive command and the real database, and it is worth
# more with no dependencies.
#
# Automation tokens are NOT environment variables. They are created in
# Settings -> Automations and stored (hashed) in the database. See
# docs/AUTOMATION.md.

# ---------------------------------------------------------------------------
# Required: the application
# ---------------------------------------------------------------------------

# Neon Serverless Postgres connection string (server only, never NEXT_PUBLIC_*).
# Must be the OWNER role (neondb_owner), not Neon's low-privilege
# `authenticator` role: migrations need CREATE.
DATABASE_URL=

# Better Auth. Secret signs sessions; generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Base URL of the app (e.g. http://localhost:3000 in development).
# Better Auth validates the request Origin against this, so it must match the
# URL the browser actually uses or every auth request is rejected.
BETTER_AUTH_URL=

# Standards-based Web Push. Generate one VAPID key pair and keep it stable
# across deployments. The public key is returned to authenticated browsers;
# the private key is server-only. Subject must be a mailto: or HTTPS contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Central n8n worker credential (server-only). Generate a high-entropy random
# value and store the same value in n8n's encrypted credential store. It is
# never a NEXT_PUBLIC variable and never replaces a user's automation token.
AUTOMATION_WORKER_SECRET=

# ---------------------------------------------------------------------------
# Required for destructive testing: a separate TEST database
# ---------------------------------------------------------------------------

# The Playwright suite and `pnpm test:account:*` delete rows. They refuse to
# run unless this points at a database whose hostname or name contains
# `goha_test` (see scripts/lib/require-test-db.mts).
#
# This is NOT a second database to operate. Create one inside the Neon project
# you already have, once:
#
#   1. Neon SQL editor, on the existing project:  CREATE DATABASE goha_test;
#   2. Put that database's connection string here.
#   3. Apply the schema to it:  DATABASE_URL=<this value> pnpm db:migrate
#
# Same project, same compute, same bill. DATABASE_URL above never changes, so
# there is no step where the owner database is one typo away from a reset.
E2E_DATABASE_URL=

# Optional E2E overrides. Defaults are the local harness constants in
# scripts/test-account.mts; set these only if the test account differs.
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_NAME=

# Optional: point the suite at an already-running app instead of letting
# Playwright start one (skips the dev-server spawn and its DATABASE_URL override,
# so the running app must already be on the test database).
# E2E_BASE_URL=
# E2E_PORT=

# --- n8n email events (server only) -------------------------------------
# GoHa never sends email. It POSTs a signed event to n8n, which owns the
# presentation and the Gmail delivery. Never prefix these NEXT_PUBLIC_.
#
# Both URLs are optional and independent: leave one unset and that event is
# skipped and logged rather than failing the request it came from. The secret
# is required for either to be used, and must be at least 32 characters.
N8N_PASSWORD_RESET_WEBHOOK_URL=
N8N_WELCOME_EMAIL_WEBHOOK_URL=
N8N_EMAIL_WEBHOOK_SECRET=
